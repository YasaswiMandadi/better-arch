# Copy these into Vercel → Project → Settings → Environment Variables.
# (Never commit real values.)

# MongoDB Atlas connection string (Database → Connect → Drivers)
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# Database name (optional, defaults to "betterarch")
MONGODB_URI=mongodb+srv://ptg_01:AOQNlKlOoovSYjKg@ptg.6rseqrw.mongodb.net/?appName=PTG
MONGODB_DB=betterarch
# The one password that unlocks /console. Use a long random string.
ADMIN_PASSWORD=change-me
# Secret used to sign admin sessions (optional; falls back to ADMIN_PASSWORD)
SESSION_SECRET=another-long-random-string
