# Copy these into Vercel → Project → Settings → Environment Variables.
# (Never commit real values.)

# MongoDB Atlas connection string (Database → Connect → Drivers)
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# Database name (optional, defaults to "betterarch")
MONGODB_URI=
MONGODB_DB=betterarch
# The one password that unlocks /console. Use a long random string.
ADMIN_PASSWORD=change-me
# Secret used to sign admin sessions (optional; falls back to ADMIN_PASSWORD)
SESSION_SECRET=another-long-random-string

# Contact form (api/contact.ts) — sends Contact-page messages by email via Resend (resend.com)
RESEND_API_KEY=
# Where messages go (defaults to ptgsaay@gmail.com for testing)
CONTACT_TO=ptgsaay@gmail.com
# Sender (optional). Leave unset to use Resend's test sender until a domain is verified.
# CONTACT_FROM=BetterArch <contact@yourdomain.org>
